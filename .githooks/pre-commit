#!/usr/bin/env bash
# Runner: every executable file in .githooks/pre-commit.d/ is one check, run in name order (byte order, so
# '10-' before '20-'). A check that exits non-zero blocks the commit; the runner names it. A new check is a new
# file there - this file is not edited for it. Enabled by sync-claude.sh (core.hooksPath .githooks, shared by
# worktrees; each worktree runs its own checked-out .githooks). ASCII only.
# The same matching whatever the user's locale; C.UTF-8, not C: -i must still fold Cyrillic case in patterns.
export LC_ALL=C.UTF-8
dir="$(dirname "$0")/pre-commit.d"
[ -d "$dir" ] || exit 0
failed=""
# NUL-separated, byte-sorted names: a name with spaces stays one name, the order does not follow the locale.
while IFS= read -r -d '' check; do
  [ -f "$check" ] && [ -x "$check" ] || continue
  # stdin is the list of checks: a check reading stdin would eat it and the later checks would silently not run.
  "$check" </dev/null
  code=$?
  if [ "$code" != 0 ]; then
    echo "pre-commit: check $(basename "$check") failed (exit $code)" >&2
    failed="$failed $(basename "$check")"
  fi
done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0 | LC_ALL=C sort -z)
if [ -n "$failed" ]; then
  echo "Commit blocked by:$failed" >&2
  exit 1
fi
exit 0
