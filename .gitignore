# Проекты, их память и рабочие репозитории — только локально, в git хаба не входят
/projects/

# Личные исследования и идеи — локально; в git только исследование, на котором построен хаб
/ideas/
/research/*
!/research/2026-08-27-ai-dev-orchestration.md
!/research/2026-08-27-ai-dev-orchestration.html

# Личное: имя пользователя, язык ответов (образец — CLAUDE.local.md.example)
/CLAUDE.local.md

# Личный список запретных имён для pre-commit (рабочие проекты, ключи задач, студии)
/.githooks/private-patterns

# Выключатель хаба (docs/hooks.md): закоммиченный, он молча выключил бы хаб у всех
/.hub-off

# Локальные настройки Claude Code
.claude/settings.local.json
**/.claude/settings.local.json

# Мусор ОС и файловых менеджеров (KDE Dolphin пишет .directory)
.directory
Thumbs.db
Desktop.ini
