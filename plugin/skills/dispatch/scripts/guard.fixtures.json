    "tools": "^Bash$",
    "commands": "^(?![\\s\\S]*ANTHROPIC_BASE_URL=[\"']?https?://(127\\.0\\.0\\.1|localhost)\\b)[\\s\\S]*?(?:^|[;&|(]\\s*|\\s)claude\\s+(-p|--print)\\b"
