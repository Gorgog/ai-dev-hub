    "commands": "(?:^|[;&|(\\n]\\s*)(?:[A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)*(?:npx\\s+playwright\\b|node\\s+\\S*shots\\S*\\.cjs\\b)"
   }
  ],
  "medium": [
   {
    "name": "установка зависимостей",
    "tools": "^Bash$",
    "commands": "(?:^|[;&|(\\n]\\s*)(?:[A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)*(?:(?:npx\\s+)?npm(?:@\\S+)?\\s+(?:ci|install|i)(?:\\s|$)|composer\\s+install\\b)"
   },
   {
    "name": "полная сборка",
    "tools": "^Bash$",
    "commands": "(?:^|[;&|(\\n]\\s*)(?:[A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)*(?:(?:npx\\s+)?npm(?:@\\S+)?\\s+run\\s+(?:build|generate)\\b|(?:npx\\s+)?nuxt\\s+(?:build|generate)\\b)"
   },
   {
    "name": "полный прогон PHP",
    "tools": "^Bash$",
    "commands": "(?:^|[;&|(\\n]\\s*)(?:[A-Za-z_][A-Za-z0-9_]*=\\S*\\s+)*(?:docker\\s+(?:run|compose\\s+run)\\b.*\\s)?php\\s+artisan\\s+test\\s*(?:$|[;&|)>]|\\d>)"
   }
  ]
 },
 "hub": {
  "heavy": [
   {
