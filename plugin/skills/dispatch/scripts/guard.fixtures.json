{
 "_comment": "Синтетические копии правил замка живых проектов (обезличено, 05.11): проект A — многосессионный node-монорепо, проект B — малый (nuxt + php), хаб — перестройка хаба. Формат dispatch-rules.json не меняется: guard.test.cjs гоняет их без правки.",
 "project-a": {
  "heavy": [
   {
    "name": "дев-серверы",
    "tools": "^mcp__Claude_Browser__preview_start$",
    "input": "\"name\"\\s*:"
   },
   {
    "name": "дев-серверы",
    "tools": "^Bash$",
    "commands": "npm\\s+run\\s+(dev|start)\\b|\\bnest\\s+start\\b|\\bnext\\s+(dev|start)\\b"
   },
   {
    "name": "проверка в браузере",
    "tools": "^mcp__(Claude_Browser|claude-in-chrome)__",
    "input": "localhost|127\\.0\\.0\\.1|\\[::1\\]"
   },
   {
    "name": "playwright и пробы",
    "tools": "^Bash$",
    "commands": "npx\\s+playwright\\b|\\bnode\\s+\\S*snippets[\\\\/]+\\S+\\.(c|m)?js\\b|\\bnode\\s+\\S*(proof|shots|probe|repro)\\S*\\.(c|m)?js\\b"
   },
   {
    "name": "jest бэка и тестовая БД",
    "tools": "^Bash$",
    "commands": "npx\\s+jest\\b|node_modules[\\\\/]+\\.bin[\\\\/]+jest\\b|npm\\s+run\\s+test:(db|seed|e2e|cov)\\b|backend-all-batches"
   },
   {
    "name": "дев-БД и миграции",
    "tools": "^Bash$",
    "commands": "prisma\\s+(migrate|db\\s+(push|seed|execute|pull))\\b|dotenv\\s+-e\\s+\\.env(\\s|$)|\\bpsql\\b|\\bdocker\\s+(start|stop|restart|exec|compose)\\b"
   },
   {
    "name": "прогон hub-run с потолком от 4G (jest, стенд в скрипте)",
    "tools": "^Bash$",
    "commands": "hub-run\\.sh\\s+(?!--)\\S+\\s+-MemoryMax\\s+([4-9]|\\d{2,})G"
   }
  ],
  "medium": [
   {
    "name": "npm ci",
    "tools": "^Bash$",
    "commands": "\\bnpm\\s+(ci|install|i)(\\s|$)"
   },
   {
    "name": "tsc",
    "tools": "^Bash$",
    "commands": "npx\\s+tsc\\b|npm\\s+run\\s+(typecheck|tsc|build)\\b"
   },
   {
    "name": "полный vitest",
    "tools": "^Bash$",
    "commands": "vitest\\s+run(\\s+--project\\s+\\S+)?\\s*($|[;&|)>]|\\d>)"
   },
   {
    "name": "kubb",
    "tools": "^Bash$",
    "commands": "kubb\\s+generate"
   },
   {
    "name": "любой прогон hub-run (команда в скрипте)",
    "tools": "^Bash$",
    "commands": "hub-run\\.sh\\s+(?!--)\\S+"
   }
  ]
 },
 "project-b": {
  "heavy": [
   {
    "name": "дев-серверы",
    "tools": "^mcp__Claude_Browser__preview_start$"
   },
   {
    "name": "дев-серверы",
