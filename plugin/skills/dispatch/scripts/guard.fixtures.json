    "tools": "^Bash$",
    "commands": "node\\s+(\\S*/)?polygon/run\\.cjs\\b(?![^|;&\\n]*--level[\\s=]+hook\\b)(?![^|;&\\n]*\\s(compare|regrade)\\b)"
   },
   {
    "name": "тесты и общая БД проекта A",
    "tools": "^Bash$",
    "commands": "npx\\s+(--yes\\s+)?jest\\b|prisma\\s+(migrate|db\\s+(push|seed|execute|pull))\\b|\\bpsql\\b|createdb\\b|dropdb\\b"
   },
   {
    "name": "дев-серверы и браузер",
